{
  "manifest_version": 3,
  "name": "Meta Black",
  "version": "1.1.0",
  "description": "A local, true-black workspace for Meta Business Suite and Ads Manager. Creatives and reporting colors stay intact.",
  "permissions": ["storage"],
  "host_permissions": ["https://business.facebook.com/*", "https://adsmanager.facebook.com/*"],
  "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png"},
  "action": {
    "default_title": "Meta Black",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/toolbar-16.png", "32": "icons/toolbar-32.png"}
  },
  "content_scripts": [{
    "matches": ["https://business.facebook.com/*", "https://adsmanager.facebook.com/*"],
    "css": ["theme.css"],
    "js": ["policy.js", "engine.js", "content.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'"}
}
